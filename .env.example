# Copy to .env (repo root or backend/) and adjust. Never commit .env.

# --- Servers -------------------------------------------------------------
AURA_API_HOST=127.0.0.1
AURA_API_PORT=8000
AURA_MCP_HOST=127.0.0.1
AURA_MCP_PORT=8765
# The agent's MCP client connects here (Streamable HTTP).
# AURA_MCP_URL=http://127.0.0.1:8765/mcp

# --- Storage -------------------------------------------------------------
# AURA_DB_PATH=./data/aura.db
# Time zone for reminder due times (IANA name). Empty = this machine's local time zone.
# AURA_TZ=America/New_York
# Seconds an open AURA tab has to confirm it showed a reminder or timer alert.
# AURA_DELIVERY_ACK_S=20

# --- Simulator & verification timing --------------------------------------
AURA_SIM_SETTLE_MS=600        # delay before a simulated device applies a command
AURA_VERIFY_TIMEOUT_S=3.0     # how long verification keeps re-reading state
AURA_VERIFY_POLL_S=0.5        # interval between verification reads
AURA_TOOL_TIMEOUT_S=5.0       # per MCP tool call
AURA_MAX_ATTEMPTS=3           # total command attempts per step (bounded retries)
AURA_AUTO_RETRY_LIMIT=1       # automatic retries allowed for unexplained losses
# Log voice transcripts and parsed reminder times to the server console (text only, no audio). 0 = off.
AURA_LOG_SPEECH=1
